# GEMINI_API_KEY: Required for Gemini AI API calls (AI Studio injects automatically or set locally).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB connection string (e.g. mongodb://localhost:27017/skill-vedanth or MongoDB Atlas URI)
# When not configured, the app uses a built-in in-memory fallback store with pre-seeded jobs and demo accounts.
MONGODB_URI="mongodb://localhost:27017/skill-vedanth"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens
JWT_SECRET="skill_vedanth_super_secret_jwt_key_2026"

# PORT: Server port (defaults to 3000 in this container environment)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

